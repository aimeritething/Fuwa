{
  "editor": {
    "fontFamily": "'Inter Variable', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif",
    "fontSize": 15,
    "fontWeight": 450,
    "lineHeight": 1.6,
    "letterSpacing": "-0.0067em",
    "maxWidth": 792,
    "paddingHorizontal": 56,
    "paddingVertical": 20,
    "paragraphSpacing": 16,
    "dividerFollowedByHeadingMarginTop": 8
  },
  "headings": {
    "h1": {
      "fontSize": 22,
      "fontWeight": 600,
      "lineHeight": "29.6px",
      "marginTop": 48,
      "marginBottom": 16,
      "color": "var(--text-heading)",
      "letterSpacing": "-0.07px"
    },
    "h2": {
      "fontSize": 19,
      "fontWeight": 600,
      "lineHeight": "28px",
      "marginTop": 32,
      "marginBottom": 16,
      "color": "var(--text-heading)",
      "letterSpacing": "0.05px"
    },
    "h3": {
      "fontSize": 17,
      "fontWeight": 600,
      "lineHeight": "24px",
      "marginTop": 24,
      "marginBottom": 6,
      "color": "var(--text-heading)",
      "letterSpacing": "0.1px"
    },
    "h4": {
      "fontSize": 15,
      "fontWeight": 600,
      "lineHeight": "24px",
      "marginTop": 22,
      "marginBottom": 6,
      "color": "var(--text-heading)",
      "letterSpacing": 0
    }
  },
  "lists": {
    "bulletSymbol": "•",
    "bulletSize": 24,
    "bulletColor": "var(--text-primary)",
    "indentSize": 24,
    "itemSpacing": 2,
    "paddingLeft": 0,
    "nestedBulletSymbols": ["•", "◦", "▪"],
    "bulletGap": 0
  },
  "checkboxes": {
    "size": 14,
    "borderRadius": 3,
    "checkedColor": "var(--text-primary)",
    "uncheckedBorderColor": "var(--text-faint)",
    "gap": 8
  },
  "inlineStyles": {
    "bold": {
      "fontWeight": 600,
      "color": "var(--text-heading)"
    },
    "italic": {
      "fontStyle": "italic",
      "color": "inherit"
    },
    "strikethrough": {
      "color": "var(--text-tertiary)",
      "textDecoration": "line-through"
    },
    "code": {
      "fontFamily": "'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
      "fontSize": "0.9375em",
      "backgroundColor": "var(--editor-inline-code-background)",
      "paddingHorizontal": "0.25em",
      "paddingVertical": "0.5px",
      "borderRadius": "0.2em",
      "color": "inherit"
    },
    "link": {
      "color": "var(--link-color)",
      "textDecoration": "none"
    },
    "wikilink": {
      "color": "var(--link-color)",
      "textDecoration": "none",
      "borderBottom": "1px dotted currentColor",
      "cursor": "pointer"
    }
  },
  "blockquote": {
    "borderLeftWidth": 4,
    "borderLeftColor": "var(--border-strong)",
    "paddingLeft": 16,
    "marginVertical": 0,
    "color": "inherit",
    "fontStyle": "normal"
  },
  "table": {
    "borderColor": "var(--border-default)",
    "headerBackground": "var(--surface-shade)",
    "cellPaddingHorizontal": 10,
    "cellPaddingVertical": 6,
    "fontSize": 15
  },
  "horizontalRule": {
    "color": "var(--border-strong)",
    "marginVertical": 22,
    "thickness": 1
  },
  "colors": {
    "background": "var(--bg-primary)",
    "text": "var(--text-primary)",
    "textSecondary": "var(--text-secondary)",
    "textMuted": "var(--text-muted)",
    "heading": "var(--text-heading)",
    "accent": "var(--accent-blue)",
    "selection": "var(--editor-selection)",
    "cursor": "var(--text-primary)"
  }
}
